{
    "keyboard_name": "Keychron J5",
    "manufacturer": "Keychron",
    "url": "https://github.com/Keychron",
    "maintainer": "Keychron",
    "processor": "WB32F3G71",
    "bootloader": "wb32-dfu",
    "usb": {
        "vid": "0x3434"
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "raw": true,
        "send_string": true
    },
    "diode_direction": "ROW2COL",
    "eeprom": {
        "driver": "i2c",
        "wear_leveling": {
            "driver": "embedded_flash",
            "logical_size": 3072,
            "backing_size": 6144
        }
    },
    "build": {
        "debounce_type": "custom"
    },
    "debounce": 50
}
